# Server
PORT=8081

# PostgreSQL (payments-owned schema — separate database or schema from captur-api)
DATABASE_URL=jdbc:postgresql://localhost:5432/captur_payments
DB_USER=postgres
DB_PASSWORD=change-me

# Privy JWT verification — REQUIRED, service rejects all tokens without these
PRIVY_APP_ID=
# PRIVY_JWKS_URL defaults to https://auth.privy.io/api/v1/apps/{APP_ID}/jwks.json

# Admin authorization — captur-api roles allowed to use /api/v1/admin/* endpoints.
# Payout approval/execution is financial: keep this to ADMIN,FINANCE.
# MODERATOR must NOT be included (content-review role, not finance).
PAYMENTS_ADMIN_ROLES=ADMIN,FINANCE

# Read-only captur-api integration (caller's Bearer token is forwarded)
CAPTUR_API_URL=https://captur-api-208129623932.asia-east2.run.app
CAPTUR_API_TIMEOUT_MS=15000
CAPTUR_PAGE_SIZE=100
CAPTUR_MAX_PAGES=20

# Reward calculation — hourly rates per device tier (USD/hour == USDC/hour).
# Rewards are ONLY created for APPROVED submissions whose device is VERIFIED
# in the device_capabilities registry. Product decisions pending — see
# docs/payments-service-audit.md.
REWARD_TIER_FULL=5.00
REWARD_TIER_IPHONE=4.50
REWARD_TIER_BASIC=3.75

# Scheduled poller — OFF by default AND must stay off until the
# double-compensation policy (token_transaction credit on APPROVED) is
# resolved with product. To enable later, ALSO set CAPTUR_API_SERVICE_TOKEN
# (a long-lived admin Privy token in Secret Manager; captur-api has no
# machine auth).
REWARD_AUTO_SYNC=false
REWARD_SYNC_INTERVAL_MS=300000
# CAPTUR_API_SERVICE_TOKEN=

# Solana — devnet only. See docs/solana-devnet-setup.md for mint/treasury setup.
# Execution additionally requires SOLANA_TREASURY_SECRET_KEY (base58 keypair,
# Secret Manager only — never commit). Cluster MUST stay devnet; mainnet is
# refused by code.
SOLANA_ENABLED=false
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=
SOLANA_USDC_DECIMALS=6
SOLANA_TREASURY_ADDRESS=
SOLANA_TREASURY_SECRET_KEY=
SOLANA_CONFIRM_TIMEOUT_MS=90000
SOLANA_CONFIRM_POLL_MS=2000
SOLANA_MAX_CONCURRENT=5
# Reconciliation job — read-only chain checks for submitted/ambiguous txs.
# Disabled by default; enable only on devnet during E2E testing.
SOLANA_RECONCILE_ENABLED=false
SOLANA_RECONCILE_INTERVAL_MS=60000
SOLANA_RECONCILE_INITIAL_DELAY_MS=30000
SOLANA_RECONCILE_BATCH_SIZE=50
